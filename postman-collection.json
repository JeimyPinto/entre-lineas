{
  "info": {
    "_postman_id": "nextauth-migration-tests",
    "name": "NextAuth Migration - API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPassword123\",\n  \"name\": \"Test User\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/auth/signup",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "auth", "signup"]
        }
      },
      "response": []
    },
    {
      "name": "Auth - Login (Credentials)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPassword123\",\n  \"callbackUrl\": \"/admin\",\n  \"redirect\": false\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/auth/callback/credentials",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "auth", "callback", "credentials"]
        }
      },
      "response": []
    },
    {
      "name": "Password Reset - Request Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/admin/password/reset",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "admin", "password", "reset"]
        }
      },
      "response": []
    },
    {
      "name": "Password Reset - Confirm New Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{RESET_TOKEN}}\",\n  \"password\": \"NewPassword123\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/admin/password/confirm",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "admin", "password", "confirm"]
        }
      },
      "response": []
    },
    {
      "name": "Users - List All Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{SESSION_TOKEN}}"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/admin/users",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "admin", "users"]
        }
      },
      "response": []
    },
    {
      "name": "Users - Invite User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{SESSION_TOKEN}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"newuser@example.com\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/admin/users",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "admin", "users"]
        }
      },
      "response": []
    },
    {
      "name": "Users - Ban User",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{SESSION_TOKEN}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"disabled\": true\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/admin/users/{{USER_ID}}",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "admin", "users", "{{USER_ID}}"]
        }
      },
      "response": []
    },
    {
      "name": "Users - Unban User",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{SESSION_TOKEN}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"disabled\": false\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/admin/users/{{USER_ID}}",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "admin", "users", "{{USER_ID}}"]
        }
      },
      "response": []
    },
    {
      "name": "Users - Delete User",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{SESSION_TOKEN}}"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/admin/users/{{USER_ID}}",
          "protocol": "http",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "admin", "users", "{{USER_ID}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "SESSION_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "RESET_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "USER_ID",
      "value": "",
      "type": "string"
    }
  ]
}
