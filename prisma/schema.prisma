generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Artist {
  id            Int       @id @default(autoincrement())
  alias         String    // Nombre artístico/apodo
  name          String
  orgRole       String[]
  image        String?
  imagePosition String    @default("50%")
  profession   String?
  origin       String?
  trajectory   String?
  bio          String[]
  socials      Json      @default("[]")
  createdAt    DateTime  @default(now()) @map("created_id")
  createdBy   String?   @map("created_by")
  socialLinks  ArtistSocial[]

  @@map("artists")
}

model ArtistSocial {
  id        Int      @id @default(autoincrement())
  artistId  Int      @map("artist_id")
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  label     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("artist_socials")
}

model Event {
  id           Int       @id @default(autoincrement())
  title       String
  date        String
  location   String?
  postUrl    String?   @map("post_url")
  youtubeLink String?  @map("youtube_link")
  judges     Json      @default("[]")
  hosts      Json      @default("[]")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("events")
}

// Location hierarchy for artists and events
// Supports countries with optional departments (Colombia) and cities

model Country {
  id          Int          @id @default(autoincrement())
  code        String       @unique // ISO 3166-1 alpha-2 (e.g., 'CO', 'AR')
  name        String       // Display name
  hasDepartments Boolean    @default(false) // Whether this country supports departments
  departments Department[] 
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("countries")
}

model Department {
  id          Int         @id @default(autoincrement())
  code        String      // Department code (e.g., 'ANT', 'DC')
  name        String      // Department name
  countryId   Int         @map("country_id")
  country     Country     @relation(fields: [countryId], references: [id])
  cities      City[]
  createdAt  DateTime    @default(now()) @map("created_at")

  @@unique([code, countryId])
  @@map("departments")
}

model City {
  id            Int         @id @default(autoincrement())
  name          String      // City name
  departmentId  Int         @map("department_id")
  department    Department  @relation(fields: [departmentId], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")

  @@unique([name, departmentId])
  @@map("cities")
}
