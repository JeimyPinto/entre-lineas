generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Enrypted password (bcrypt)
  name     String?
  role     String   @default("admin")
  active   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Artist {
  id            Int       @id @default(autoincrement())
  name          String
  orgRole       String[]
  image        String?
  imagePosition String    @default("50%")
  profession   String?
  origin       String?
  trajectory   String?
  bio          String[]
  socials      Json      @default("[]")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")

  @@map("artists")
}

model Event {
  id           Int       @id @default(autoincrement())
  title       String
  date        String
  location   String?
  postUrl    String?   @map("post_url")
  youtubeLink String?  @map("youtube_link")
  judges     Json      @default("[]")
  hosts      Json      @default("[]")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("events")
}
